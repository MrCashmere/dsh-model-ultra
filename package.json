{
  "name": "dsh-model-pro",
  "version": "1.1.1",
  "description": "Model Pro — DSH plugin for llm-pi-ai provider lifecycle: create/edit, custom headers, enable/disable with uninstall-restore safety, model discovery, and per-model connectivity tests",
  "main": "dist/host.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node tests/host.smoke.mjs && node tests/client.smoke.mjs",
    "run:host": "node scripts/run-host.mjs",
    "prepare": "test -f src/host/index.ts && npm run build || true",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm-pi-ai",
    "plugin",
    "model-provider",
    "settings"
  ],
  "author": "wqy8593521",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wqy8593521/dsh-model-pro.git"
  },
  "bugs": {
    "url": "https://github.com/wqy8593521/dsh-model-pro/issues"
  },
  "homepage": "https://github.com/wqy8593521/dsh-model-pro#readme",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "tsup": "^8",
    "typescript": "^5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0"
  }
}
