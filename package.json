{
  "name": "dsh-model-ultra",
  "version": "2.0.2",
  "description": "Model Ultra — DSH plugin for llm-pi-ai provider lifecycle: create/edit, custom headers, enable/disable with uninstall-restore safety, per-model thinking effort, OpenRouter provider routing, smart routing, composites, observability, and per-model connectivity tests",
  "type": "module",
  "main": "dist/host.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/host.smoke.mjs && node tests/client.smoke.mjs",
    "run:host": "node scripts/run-host.mjs",
    "install:local": "node scripts/install-local.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm-pi-ai",
    "plugin",
    "bundle",
    "model-provider",
    "settings",
    "thinking",
    "reasoning-effort",
    "openrouter",
    "desktop"
  ],
  "author": "wqy8593521 (original dsh-model-pro) · MrCashmere",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrCashmere/dsh-model-ultra.git"
  },
  "bugs": {
    "url": "https://github.com/MrCashmere/dsh-model-ultra/issues"
  },
  "homepage": "https://github.com/MrCashmere/dsh-model-ultra#readme",
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0"
  }
}
