node_modules/
*.log
.DS_Store
.env
.env.*

# Never commit credentials: a project-local .npmrc can carry an npm publish
# token (`//registry.npmjs.org/:_authToken=…`). Keep it in ~/.npmrc instead.
.npmrc
.netrc
*.pem
*.key

# Release tarball produced by `npm pack` (CI builds and uploads its own)
*.tgz

# Build output (regenerated by scripts/build.mjs; shipped only in the npm tarball)
/dist/

# Legacy single-file builds (superseded by /dist from scripts/build.mjs)
/host.js
/client.js

# pnpm is only a local fallback; npm + package-lock.json are canonical here
pnpm-lock.yaml
.pnpm-store/

# Local draft: linux.do forum post (not part of the project)
/docs/linuxdo-post.md
